<% chat_members = chat.chat_memberships.active.includes(:participant).order(:id).to_a %>
<% mention_lookup = chat_member_mention_lookup(chat: chat) %>
<% role_options = TurboChat.configuration.role_definitions.map do |role_key, definition|
  [definition[:name].presence || role_key.to_s.humanize, role_key.to_s, definition[:rank].to_i]
end.sort_by { |(role_name, role_key, role_rank)| [role_rank, role_name.to_s.downcase, role_key] } %>

<% if chat_members.empty? %>
  <li class="chat-members-item chat-members-item--hint">
    <span class="chat-hint">No active members yet.</span>
  </li>
<% else %>
  <% chat_members.each do |membership| %>
    <% participant = membership.participant %>
    <% participant_type = membership.participant_type.to_s %>
    <% participant_id = membership.participant_id.to_s %>
    <% mention_entry = mention_lookup["#{participant_type}:#{participant_id}"] || {} %>
    <% participant_name = chat_participant_name(participant) %>
    <% participant_email = chat_participant_email(participant).to_s %>
    <% invite_label = chat_participant_invite_option_label(participant) %>
    <% invite_search_value = chat_participant_search_text(participant).downcase %>
    <li class="chat-members-item"
        data-chat-member-entry="true"
        data-chat-id="<%= chat.id %>"
        data-chat-member-membership-id="<%= membership.id %>"
        data-chat-member-participant-type="<%= participant_type %>"
        data-chat-member-participant-id="<%= participant_id %>"
        data-chat-member-mention-token="<%= mention_entry[:token].to_s %>"
        data-chat-member-name="<%= participant_name %>"
        data-chat-member-email="<%= participant_email %>"
        data-chat-member-invite-label="<%= invite_label %>"
        data-chat-member-search="<%= invite_search_value %>"
        data-chat-member-role-key="<%= membership.effective_role_key %>"
        data-chat-member-role-name="<%= membership.effective_role_name %>"
        data-chat-member-role-rank="<%= membership.effective_role_rank %>">
      <div class="chat-members-item-main">
        <span class="chat-members-name"><%= participant_name %></span>
        <span class="chat-members-role"><%= membership.effective_role_name %></span>
      </div>

      <%= form_with url: TurboChat::Engine.routes.url_helpers.chat_chat_membership_path(chat_id: chat.id, id: membership.id),
                    method: :patch,
                    scope: :chat_membership,
                    class: "chat-member-role-form",
                    data: { chat_member_role_form: true } do |f| %>
        <%= f.select :role_key,
                     options_for_select(role_options.map { |(role_name, role_key, _role_rank)| [role_name, role_key] }, membership.effective_role_key),
                     {},
                     class: "chat-member-role-select",
                     data: { chat_member_role_input: true } %>
        <%= f.submit "Save",
                     class: "chat-btn chat-btn--small chat-member-role-submit",
                     data: { chat_member_role_submit: true } %>
      <% end %>
    </li>
  <% end %>
<% end %>
